-
  var navItems = [
    { name: "Проєкти", icon: "bi-check2-square", active: true },
    { name: "Команда", icon: "bi-people", active: false },
    { name: "Звіти", icon: "bi-file-earmark-text", active: false }
  ]

//- Cookie
.cookie-banner
  .cookie-left
    i.bi.bi-cookie.cookie-icon
    span.cookie-text Ми використовуємо cookie, щоб зробити роботу в DevSolve зручнішою. 
    a.cookie-link(href="#") Детальніше
  .cookie-actions
    button.btn-cookie-outline Параметри
    button.btn-cookie-dark Згодитися

//- Верхня шапка з генерацією меню через цикл each
header.top-header
  .header-left
    .brand
      .brand-logo
        i.bi.bi-layers-fill
      .brand-titles
        h1.brand-name DevSolve
        span.brand-desc Робочий простір команди
    nav.nav-menu
      each item in navItems
        button.nav-item(class=item.active ? "active" : "")
          i.bi(class=item.icon)
          span= item.name

  .header-right
    .search-box
      i.bi.bi-search
      input(type="text" placeholder="Пошук...")
    button.btn-icon
      i.bi.bi-bell
    .user-pill
      img.user-avatar-circle(src="/p1.jpg" alt="Ірина Коваль")
      span.user-fullname Ірина Коваль
      i.bi.bi-chevron-down