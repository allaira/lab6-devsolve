//-Cookie
.cookie-banner
  .cookie-left
    i.bi.bi-cookie.cookie-icon
    span.cookie-text Ми використовуємо cookie, щоб зробити роботу в DevSolve зручнішою. 
    a.cookie-link(href="#") Детальніше
  .cookie-actions
    button.btn-cookie-outline Параметри
    button.btn-cookie-dark Згодитися

//- верхня шапка
header.top-header
  .header-left
    .brand
      .brand-logo
        i.bi.bi-layers-fill
      .brand-titles
        h1.brand-name DevSolve
        span.brand-desc Робочий простір команди
    nav.nav-menu
      button.nav-item.active
        i.bi.bi-check2-square
        span Проєкти
      button.nav-item
        i.bi.bi-people
        span Команда
      button.nav-item
        i.bi.bi-file-earmark-text
        span Звіти

  .header-right
    .search-box
      i.bi.bi-search
      input(type="text" placeholder="Пошук...")
    button.btn-icon
      i.bi.bi-bell
    .user-pill
      img.user-avatar-circle(src="/src/img/p1.jpg" alt="Ірина Коваль")
      span.user-fullname Ірина Коваль
      i.bi.bi-chevron-down